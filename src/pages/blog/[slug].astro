---
import type { WordPressPost } from '@/types/wordpress';
import PostMeta from '@/components/atoms/PostMeta.astro';
import Layout from '@/layouts/Layout.astro';

interface Props {
  slug: string;
}

const { slug } = Astro.props;

// Placeholder pour la page de détail
// En PhantomWP, les vraies données proviendraient du MCP
const post: WordPressPost = {
  id: 1,
  title: { rendered: 'Bienvenue sur le blog' },
  content: {
    rendered: `
      <p>Ceci est un article de placeholder pour tester le design de la page de détail.</p>
      <h2>Section d'exemple</h2>
      <p>Vous pouvez ici voir comment s'affichera le contenu enrichi depuis WordPress.</p>
      <p>Les vrais articles apparaîtront une fois connectés au MCP PhantomWP.</p>
    `
  },
  excerpt: { rendered: '<p>Un article exemple avec du contenu placeholder.</p>' },
  slug: 'bienvenue-blog',
  date: new Date().toISOString(),
  modified: new Date().toISOString(),
  author: 1,
  featured_media: 0,
  status: 'publish',
  type: 'post',
  categories: [1],
  tags: [],
  comment_status: 'open',
  ping_status: 'closed',
  sticky: false,
  template: '',
  format: 'standard',
  link: '/blog/bienvenue-blog',
  _embedded: {
    author: [
      {
        id: 1,
        name: 'Admin',
        url: 'https://example.com',
        description: '',
        link: 'https://example.com/author/admin',
        slug: 'admin',
        avatar_urls: {
          '24': 'https://via.placeholder.com/24',
          '48': 'https://via.placeholder.com/48',
          '96': 'https://via.placeholder.com/96'
        }
      }
    ],
    'wp:term': [
      [
        {
          id: 1,
          link: '/blog/category/general',
          name: 'Général',
          slug: 'general',
          taxonomy: 'category',
          description: '',
          count: 1
        }
      ]
    ]
  }
};

const author = post._embedded?.author?.[0];
const categories = post._embedded?.['wp:term']?.[0]?.filter(
  (term) => term.taxonomy === 'category'
);
const firstCategory = categories?.[0]?.name;
---

<Layout title={post.title.rendered}>
  <article class="blog-post-detail">
    <header class="post-header">
      <h1>{post.title.rendered}</h1>
      <PostMeta
        date={post.date}
        author={author?.name}
        category={firstCategory}
      />
    </header>

    <div class="post-body" set:html={post.content.rendered} />

    <footer class="post-footer">
      <a href="/blog" class="back-link">← Retour au blog</a>
    </footer>
  </article>
</Layout>

<style>
  .blog-post-detail {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-xl);
  }

  .post-header {
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .post-header h1 {
    margin: 0 0 var(--space-md) 0;
    font-size: var(--font-size-4xl);
    line-height: 1.2;
  }

  .post-body {
    font-size: var(--font-size-base);
    line-height: 1.8;
    color: var(--color-text);
    margin-bottom: var(--space-2xl);
  }

  .post-body :global(h2) {
    margin: var(--space-xl) 0 var(--space-md) 0;
    font-size: var(--font-size-2xl);
  }

  .post-body :global(h3) {
    margin: var(--space-lg) 0 var(--space-md) 0;
    font-size: var(--font-size-lg);
  }

  .post-body :global(p) {
    margin: 0 0 var(--space-md) 0;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin: var(--space-md) 0;
    padding-left: var(--space-lg);
  }

  .post-body :global(li) {
    margin-bottom: var(--space-sm);
  }

  .post-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    margin: var(--space-lg) 0;
  }

  .post-body :global(blockquote) {
    margin: var(--space-lg) 0;
    padding-left: var(--space-lg);
    border-left: 4px solid var(--color-primary);
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .post-footer {
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .blog-post-detail {
      padding: var(--space-lg);
    }

    .post-header h1 {
      font-size: var(--font-size-3xl);
    }
  }

  @media (prefers-color-scheme: dark) {
    .post-header,
    .post-footer {
      border-color: var(--color-border-dark);
    }

    .post-body :global(blockquote) {
      border-left-color: var(--color-primary-light);
    }

    .back-link:hover {
      color: var(--color-primary-light);
    }
  }
</style>
