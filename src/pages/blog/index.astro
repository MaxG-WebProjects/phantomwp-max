---
import type { WordPressPost } from '@/types/wordpress';
import BlogPostCard from '@/components/molecules/BlogPostCard.astro';
import Layout from '@/layouts/Layout.astro';

// Workflow :
// - En local : placeholders pour tester le design
// - En PhantomWP : le MCP enrichit les données (via une source ou collection générée)
// Les composants sont agnostiques de la source des données

const isPreview = true; // Toujours true en local, false en PhantomWP avec vraies données

// Placeholders pour le développement local
let posts: WordPressPost[] = [];
  posts = [
    {
      id: 1,
      title: { rendered: 'Bienvenue sur le blog' },
      content: { rendered: '<p>Ceci est un article de placeholder pour tester le design.</p>' },
      excerpt: { rendered: '<p>Un article exemple avec du contenu placeholder pour montrer comment s\'affichent les posts.</p>' },
      slug: 'bienvenue-blog',
      date: new Date().toISOString(),
      modified: new Date().toISOString(),
      author: 1,
      featured_media: 0,
      status: 'publish',
      type: 'post',
      categories: [1],
      tags: [],
      comment_status: 'open',
      ping_status: 'closed',
      sticky: false,
      template: '',
      format: 'standard',
      link: '/blog/bienvenue-blog',
      _embedded: {
        author: [
          {
            id: 1,
            name: 'Admin',
            url: 'https://example.com',
            description: '',
            link: 'https://example.com/author/admin',
            slug: 'admin',
            avatar_urls: {
              '24': 'https://via.placeholder.com/24',
              '48': 'https://via.placeholder.com/48',
              '96': 'https://via.placeholder.com/96'
            }
          }
        ],
        'wp:term': [
          [
            {
              id: 1,
              link: '/blog/category/general',
              name: 'Général',
              slug: 'general',
              taxonomy: 'category',
              description: '',
              count: 1
            }
          ]
        ]
      }
    },
    {
      id: 2,
      title: { rendered: 'Deuxième article exemple' },
      content: { rendered: '<p>Un autre article de placeholder.</p>' },
      excerpt: { rendered: '<p>Cet article montre comment les posts s\'affichent en grille responsive.</p>' },
      slug: 'deuxieme-article',
      date: new Date(Date.now() - 86400000).toISOString(),
      modified: new Date(Date.now() - 86400000).toISOString(),
      author: 1,
      featured_media: 0,
      status: 'publish',
      type: 'post',
      categories: [1],
      tags: [],
      comment_status: 'open',
      ping_status: 'closed',
      sticky: false,
      template: '',
      format: 'standard',
      link: '/blog/deuxieme-article',
      _embedded: {
        author: [
          {
            id: 1,
            name: 'Admin',
            url: 'https://example.com',
            description: '',
            link: 'https://example.com/author/admin',
            slug: 'admin',
            avatar_urls: {
              '24': 'https://via.placeholder.com/24',
              '48': 'https://via.placeholder.com/48',
              '96': 'https://via.placeholder.com/96'
            }
          }
        ],
        'wp:term': [
          [
            {
              id: 1,
              link: '/blog/category/general',
              name: 'Général',
              slug: 'general',
              taxonomy: 'category',
              description: '',
              count: 1
            }
          ]
        ]
      }
    }
  ];
}
---

<Layout title="Blog">
  <section class="blog-section">
    <div class="blog-header">
      <h1>Blog</h1>
      {isPreview && <p class="preview-notice">Mode aperçu — données placeholder</p>}
    </div>

    {
      posts.length > 0 ? (
        <div class="posts-grid">
          {posts.map((post) => (
            <BlogPostCard post={post} />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>Aucun article disponible pour le moment.</p>
        </div>
      )
    }
  </section>
</Layout>

<style>
  .blog-section {
    padding: var(--space-xl);
    max-width: 1200px;
    margin: 0 auto;
  }

  .blog-header {
    margin-bottom: var(--space-xl);
    text-align: center;
  }

  .blog-header h1 {
    margin: 0 0 var(--space-sm) 0;
    font-size: var(--font-size-4xl);
  }

  .preview-notice {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    font-style: italic;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-lg);
  }

  .empty-state {
    padding: var(--space-4xl) var(--space-lg);
    text-align: center;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }

  .empty-state p {
    margin: 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .blog-section {
      padding: var(--space-lg);
    }

    .blog-header h1 {
      font-size: var(--font-size-3xl);
    }

    .posts-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-color-scheme: dark) {
    .empty-state {
      background: var(--color-surface-dark);
      border-color: var(--color-border-dark);
    }
  }
</style>
