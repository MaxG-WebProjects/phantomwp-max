---
interface Props {
    bg?: 'surface' | 'surface-alt' | 'primary' | 'dark' | 'none';
    size?: 'sm' | 'md' | 'lg' | 'full';
    padding?: 'sm' | 'md' | 'lg' | 'none';
    title?: string;
    class?: string;
}

const { bg = 'none', size = 'lg', padding = 'lg', title, class: className } = Astro.props;
---

<section
    class:list={[
        "section",
        bg !== 'none' && `bg-${bg}`,
        `size-${size}`,
        padding !== 'none' && `pad-${padding}`,
        className,
    ]}
>
    <div class="container">
        {title && (<h2>{title}</h2>)}
        <slot />
    </div>
</section>

<style>
    .section {
        display: block;
    }

    .bg-surface {
        background-color: var(--color-surface);
    }

    .bg-surface-alt {
        background-color: var(--color-surface-alt);
    }

    .bg-primary {
        background-color: var(--color-primary);
        color: #ffffff;
    }

    .bg-dark {
        background-color: #030712;
        color: #ffffff;
    }

    .pad-sm {
        --section-padding: var(--space-2xl);
    }

    .pad-md {
        --section-padding: calc(var(--space-2xl) + var(--space-md));
    }

    .pad-lg {
        --section-padding: calc(var(--space-2xl) + var(--space-xl));
    }

    .pad-sm,
    .pad-md,
    .pad-lg {
        padding-block: var(--section-padding);
    }

    .container {
        margin-inline: auto;
        padding-inline: var(--space-lg);
    }

    .size-sm .container {
        max-width: var(--container-3xl, 48rem);
    }

    .size-md .container {
        max-width: var(--container-5xl, 64rem);
    }

    .size-lg .container {
        max-width: var(--container-7xl, 80rem);
    }

    .size-full .container {
        max-width: var(--container-full, 100%);
    }

    h2 {
        margin: 0 0 var(--space-xl);
        font-size: var(--text-2xl, 1.5rem);
        font-weight: var(--font-weight-semibold, 600);
        color: inherit;
    }
</style>
