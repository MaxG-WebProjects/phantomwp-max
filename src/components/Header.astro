---
import MainMenu from './menus/MainMenu.astro';
import BrandLogo from './BrandLogo.astro';

interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<header class:list={["site-header", className]}>
    <div class="container">
        <BrandLogo siteName="My Site" class="logo" />
        <MainMenu />
    </div>
</header>

<style>
    .site-header {
        padding-block: var(--space-sm);
    }

    .container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: var(--container-3xl, 48rem);
        margin-inline: auto;
        padding-inline: var(--space-md);
    }

    .logo {
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--color-content);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .logo:hover {
        color: var(--color-primary);
    }

    .logo:focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: var(--space-xs);
        border-radius: var(--radius-sm);
    }
</style>
