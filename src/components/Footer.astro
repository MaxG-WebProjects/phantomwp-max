---
interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<footer class:list={["site-footer", className]}>
    <p>Built with PhantomWP</p>
</footer>

<style>
    .site-footer {
        max-width: var(--container-3xl, 48rem);
        margin-inline: auto;
        padding: var(--space-xl) var(--space-md);
        text-align: center;
        border-top: 1px solid var(--color-outline-light);
    }

    p {
        margin: 0;
        font-size: 0.875rem;
        color: var(--color-content-lighter);
    }
</style>
